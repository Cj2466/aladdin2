FINNHUB_API_KEY=your_finnhub_api_key_here

# Free key from fredaccount.stlouisfed.org (instant self-service signup).
# Powers the Macro Environment section (inflation, Treasury yields, debt,
# GDP, unemployment). Without it, that section's cards show "Data
# unavailable" instead of breaking the rest of the app.
FRED_API_KEY=your_fred_api_key_here

# Enables email via Resend (https://resend.com). Alert emails are still
# optional without this — they just fire in-app instead. Registration is
# NOT optional: without a real key, the verification email required to
# activate a new account never sends, and the account is stuck unverified
# with no way to complete sign-up until RESEND_API_KEY is set and the
# account uses "resend verification".
RESEND_API_KEY=
ALERT_EMAIL_FROM=onboarding@resend.dev

# Used to build the links in password-reset/verification emails. Must be
# the frontend's real public origin in production (the Cloudflare Pages
# URL), not the Render backend URL.
FRONTEND_URL=http://localhost:5173

# Local dev default is SQLite; leave unset to use it. Production points
# this at a Neon Postgres connection string via Render's dashboard (see
# render.yaml) — never commit a real value here.
DATABASE_URL=sqlite:///./aladdin2.db

# Comma-separated list of origins allowed to call this API with
# credentials. Matches the Vite dev server locally; production sets this
# to the Cloudflare Pages URL.
ALLOWED_ORIGINS=http://localhost:5173

# Local dev runs over plain http:// — a Secure cookie would be silently
# dropped by the browser. Production (served over HTTPS by Render) sets
# this to True.
COOKIE_SECURE=False

# Local dev is same-site (frontend and backend both on localhost), so Lax
# is sufficient. Production (Cloudflare Pages <-> Render, different
# domains) must use "none", which requires COOKIE_SECURE=True above.
COOKIE_SAMESITE=lax

# --- Autonomous portfolio construction ---------------------------------------
# Which optimizer the autonomous portfolio runner reweights the system-owned
# portfolio with. "mean_variance" (the default, and the only method that runner
# has ever used) is the long-only SLSQP max-Sharpe optimizer with its 0.4
# per-strategy cap; "hrp" is Hierarchical Risk Parity (Lopez de Prado 2016),
# which uses only the covariance structure, never inverts it, and applies no
# cap. Leaving this unset changes nothing. An unrecognized value is rejected at
# startup rather than silently falling back. Whichever method actually produced
# a portfolio's stored weights is recorded on the portfolio row and returned by
# the API, so the two are never indistinguishable.
AUTONOMOUS_PORTFOLIO_OPTIMIZATION_METHOD=mean_variance

# --- Execution (Phase 5, paper trading) -------------------------------------
# Alpaca trading credentials. This is the ONLY part of the system that can
# place an order, so treat these differently from the read-only data keys
# above.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Going live requires BOTH of the next two: ALPACA_PAPER_TRADING=False AND
# ALPACA_LIVE_TRADING_CONFIRMED=True. Two independently-named flags, so one
# accidental env edit — a copied .env, a typo'd deploy variable — can never by
# itself point this system at real money. Anything short of both resolves to
# paper.
ALPACA_PAPER_TRADING=True
ALPACA_LIVE_TRADING_CONFIRMED=False

# Tight enough that a kill-switch flip or a loss breach takes effect within
# about a minute.
EXECUTION_CHECK_INTERVAL_SECONDS=60

# The fraction of account equity this system may ever deploy — a second line
# of defense entirely independent of the optimizer's own weights.
EXECUTION_CAPITAL_FRACTION=0.5

# Hard DOLLAR ceilings, deliberately not redundant with the optimizer's
# max-weight cap: that is a fraction and scales up with equity (including with
# a bug that inflates an equity reading). These do not. Conservative
# placeholders — raising them should require a deliberate, informed decision.
EXECUTION_MAX_POSITION_NOTIONAL=1000.0
EXECUTION_MAX_TOTAL_NOTIONAL=5000.0

# Account-wide daily-loss circuit breaker. Measured against Alpaca's own
# equity/last_equity, not our arithmetic. Once it fires, trading cannot be
# resumed until the next trading day.
EXECUTION_DAILY_LOSS_LIMIT_PCT=0.03

# Deltas smaller than this are not worth an order.
EXECUTION_MIN_ORDER_NOTIONAL=5.0

# Where circuit-breaker alerts are sent. Leave blank to disable (send_email
# already tolerates a missing key without breaking the caller).
EXECUTION_ALERT_EMAIL=
