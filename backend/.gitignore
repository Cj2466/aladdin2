.env
venv/
__pycache__/
*.egg-info/
.pytest_cache/
*.db
# Raw SEC EDGAR companyfacts JSON cache (refetchable vendor input, not results)
data/edgar_companyfacts/
# Parsed SEC Insider Transactions Data Sets cache, 6.3MB (refetchable vendor
# input, not results -- fetch_insider_trades rebuilds it from sec.gov in ~82
# rate-limited requests; the RESULTS live in cross_sectional_trial_results)
data/insider_form4_trades.csv.gz
data/insider_form4_trades.csv.report.json
# SEC EDGAR filing narrative-text cache, ~0.6GB gzipped at full-universe scale
# (refetchable vendor input, not results -- EdgarFilingTextProvider rebuilds it
# from www.sec.gov/Archives; an archived filing is immutable so the cache needs
# no age bound. The RESULTS live in cross_sectional_trial_results and
# data/research_runs/lazy_prices_*.txt)
data/edgar_filing_text/
# Binance USDT-perp funding/kline CSV cache, ~19MB (refetchable vendor input,
# not results -- BinanceFuturesProvider rebuilds it from the keyless public
# fapi endpoints; the RESULTS live in cross_sectional_trial_results and
# data/research_runs/funding_carry_*.txt)
data/binance_futures/
# Raw SEC Form 13F structured-data-set ZIPs + fails-to-deliver ZIPs, ~2.7GB
# (refetchable vendor input, not results -- Form13FProvider rebuilds it from
# sec.gov's own published index; the RESULTS live in cross_sectional_trial_results
# and data/research_runs/best_ideas_13f_*.txt)
data/form13f_raw/
# SEC EDGAR Item 2.02 announcement-calendar cache for the earnings-
# announcement-premium family, ~4MB (refetchable vendor input, not results --
# data/research_runs/fetch_eap_announcement_calendar.py rebuilds it from
# sec.gov; the RESULTS live in cross_sectional_trial_results and
# data/research_runs/earnings_announcement_premium_*.txt)
data/eap_edgar_announcement_calendar.json
# Raw FINRA bi-monthly equity short interest files, ~366MB across 208 settlement
# cycles (refetchable vendor input, not results -- FinraShortInterestProvider
# rebuilds it from cdn.finra.org; an archived cycle file is immutable so the
# cache needs no age bound. The RESULTS live in cross_sectional_trial_results
# and data/research_runs/short_interest_*.txt)
data/finra_short_interest/
# SEC XBRL frames cache for dei:EntityCommonStockSharesOutstanding, ~37 quarterly
# JSON files (refetchable vendor input, not results -- SecSharesOutstandingProvider
# rebuilds it from data.sec.gov in ~37 requests)
data/sec_shares_outstanding/
# yfinance ex-dividend-date calendar cache for the dividend-month-premium
# family, ~0.5MB (refetchable vendor input, not results --
# data/research_runs/fetch_dividend_calendar.py rebuilds it from Yahoo's
# corporate-actions feed in ~30s; the RESULTS live in
# cross_sectional_trial_results and
# data/research_runs/dividend_month_premium_*.txt)
data/dividend_month_ex_date_calendar.json
# Point-in-time raw price store, ~120MB at full 768-name/11-year scale
# (price_store.py). UNLIKE every other entry in this file this one is NOT
# simply "refetchable vendor input": a rebuild re-asks Yahoo, and Yahoo's
# answer for an ALREADY-STORED date can have changed since — which is the
# whole reason the store exists. What survives a wipe is close but not
# identical, so a wipe forfeits bit-exact reproduction of any result computed
# before it. It is still gitignored because ~120MB of vendor rows does not
# belong in git history; the durable RESULTS live in
# cross_sectional_trial_results and data/research_runs, and a rebuild is
# recorded by price_store.write_store_manifest so a run can say which store
# state produced it.
data/price_store/
