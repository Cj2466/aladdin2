# Local dev default matches the backend's default port; leave unset to use
# it. In production this should be the Cloudflare Pages site's OWN origin
# (e.g. https://aladdin2.pages.dev) — API calls are proxied same-origin via
# functions/api/[[path]].js to the Render backend, so the login cookie
# isn't a third-party cookie (Safari/Chrome privacy modes block those).
VITE_API_BASE_URL=http://localhost:8000

# Live quotes carry no auth cookie, so this points straight at the backend
# even in production, bypassing the proxy above. Leave unset locally — it
# falls back to VITE_API_BASE_URL. In production set this to the Render
# backend URL directly (e.g. https://aladdin2-backend.onrender.com).
VITE_WS_BASE_URL=
